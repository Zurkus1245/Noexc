generator client {
  provider          = "prisma-client"
  output            = "../src/generated/prisma"
  moduleFormat      = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  coach
  client
}

enum ConsentType {
  tos
  health_data
  coach_access
  marketing
}

enum LinkStatus {
  active
  paused
  ended
}

enum EndedBy {
  coach
  client
  admin
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  authSubject String   @unique @db.VarChar(255)
  role        UserRole
  displayName String   @db.VarChar(80)
  timezone    String   @db.VarChar(64)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  consents    Consent[]
  invites     Invite[]
  coachLinks  CoachClient[] @relation("coachLinks")
  clientLinks CoachClient[] @relation("clientLinks")
  planVersions    PlanVersion[]
  calendarEntries CalendarEntry[]
}

// Append-only: a row is never updated or deleted except by account deletion.
model Consent {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ConsentType
  version   String      @db.VarChar(32)
  granted   Boolean
  createdAt DateTime    @default(now()) @db.Timestamptz(3)

  @@index([userId, type, createdAt])
}

model Invite {
  id        String    @id @default(uuid()) @db.Uuid
  coachId   String    @db.Uuid
  coach     User      @relation(fields: [coachId], references: [id], onDelete: Cascade)
  codeHash  String    @unique @db.Char(64)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([coachId])
}

// At most one non-ended link per (coachId, clientId) and the open-parties check are created in the migration SQL.
// A party is NULL only after that user deleted their account; the ended link stays with the other party.
model CoachClient {
  id        String    @id @default(uuid()) @db.Uuid
  coachId   String?   @db.Uuid
  clientId  String?   @db.Uuid
  coach     User?     @relation("coachLinks", fields: [coachId], references: [id], onDelete: SetNull)
  client    User?     @relation("clientLinks", fields: [clientId], references: [id], onDelete: SetNull)
  status    LinkStatus
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  endedAt   DateTime? @db.Timestamptz(3)
  endedBy   EndedBy?
  planVersions    PlanVersion[]
  calendarEntries CalendarEntry[]

  // Keyset-paged link lists: the party column, then the (createdAt, id) order; the coach list also filters on status.
  @@index([coachId, status, createdAt, id])
  @@index([clientId, createdAt, id])
}

// Immutable plan versions of one link: an edit inserts version + 1 and never updates a row.
// The current version is the highest one; version 0 (the empty plan) has no row.
model PlanVersion {
  id          String      @id @default(uuid()) @db.Uuid
  linkId      String      @db.Uuid
  link        CoachClient @relation(fields: [linkId], references: [id], onDelete: Cascade)
  version     Int
  content     Json
  createdById String?     @db.Uuid
  createdBy   User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)

  @@unique([linkId, version])
}

// Client-generated id. workoutKey resolves against the link's current plan version on every read.
model CalendarEntry {
  id         String      @id @db.Uuid
  linkId     String      @db.Uuid
  link       CoachClient @relation(fields: [linkId], references: [id], onDelete: Cascade)
  clientId   String?     @db.Uuid
  client     User?       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date       DateTime    @db.Date
  workoutKey String      @db.Uuid
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @db.Timestamptz(3)

  @@index([clientId, date])
  @@index([linkId, date])
}

// Fixed-window counter; one row per (key, window) incremented atomically.
model RateLimitHit {
  key         String   @db.VarChar(255)
  windowStart DateTime @db.Timestamptz(3)
  hits        Int

  @@id([key, windowStart])
}

// Keyed by auth subject without a foreign key: account deletion removes these rows explicitly, in the same transaction.
model IdempotencyRecord {
  subject        String    @db.VarChar(255)
  key            String    @db.Uuid
  requestHash    String    @db.Char(64)
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime  @db.Timestamptz(3)

  @@id([subject, key])
  @@index([expiresAt])
}
